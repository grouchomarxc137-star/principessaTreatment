{
  "name": "principessa-treatment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.0",
    "express": "5.2.1",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "scripts": {
    "db": "node scripts/dev-db.mjs",
    "dev": "node scripts/check-ports.mjs && concurrently --kill-others-on-fail -n db,api,app -c yellow,magenta,cyan \"npm:db\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "PORT=3001 tsx watch --clear-screen=false server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "typecheck": "tsc -p server && tsc -p client",
    "build": "prisma generate && vite build --config client/vite.config.ts && esbuild server/src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=server/dist/index.js",
    "start": "prisma migrate deploy && node server/dist/index.js",
    "vapid": "web-push generate-vapid-keys",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  }
}
