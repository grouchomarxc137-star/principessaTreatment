# Postgres connection. On Railway this is provided by the Postgres service
# (reference it as ${{Postgres.DATABASE_URL}}).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/principessa"

# Passwords for the two accounts. The server creates both users on start and
# updates a password (signing that person out everywhere) when it changes here.
# Choose long ones; each phone only needs it once.
PRINCIPESSA_PASSWORD="change-me"
PRINCIPE_PASSWORD="change-me-too"

# Port for the API server (Railway sets this for you).
PORT=3001

# Push notifications (optional). Generate a pair with `npm run vapid`.
# Without these the app still updates live while it's open.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Where uploaded media will live once media is switched on (a Railway volume
# mount path in production). Not used yet.
MEDIA_DIR="media"
